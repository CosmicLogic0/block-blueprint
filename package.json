{
  "name": "block-blueprint",
  "productName": "Block Blueprint",
  "desktopName": "block-blueprint.desktop",
  "version": "1.3.0",
  "description": "Design Minecraft builds in 3D, then build them in your world with the Build Blueprint mod",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "three": "^0.186.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "author": "CosmicLogic",
  "repository": {
    "type": "git",
    "url": "https://github.com/CosmicLogic0/block-blueprint.git"
  },
  "build": {
    "appId": "dev.buildblueprint.app",
    "productName": "Block Blueprint",
    "artifactName": "Block-Blueprint-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/**",
      "renderer/**",
      "assets/**",
      "!renderer/templates/_old/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Block Blueprint",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon-512.png",
      "category": "Game",
      "executableName": "block-blueprint",
      "maintainer": "CosmicLogic",
      "synopsis": "Design Minecraft builds in 3D",
      "artifactName": "Block-Blueprint-${version}-linux.${ext}",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.games",
      "identity": "-",
      "artifactName": "Block-Blueprint-${version}-mac.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Block Blueprint"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CosmicLogic0",
        "repo": "block-blueprint",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "minecraft",
    "blueprint",
    "builder"
  ]
}
